#
# Partition Table
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

#
# Zigbee
#
CONFIG_ZB_ENABLED=y

#
# Wi-Fi / IEEE 802.15.4 coexistence (ESP32-C6)
#
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

#
# FreeRTOS
#
CONFIG_FREERTOS_HZ=1000

#
# mbedTLS — keep size down; LAN MQTT without TLS by default
#
CONFIG_MBEDTLS_AES_C=y
CONFIG_MBEDTLS_CCM_C=y
CONFIG_MBEDTLS_GCM_C=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_MBEDTLS_CMAC_C=n
CONFIG_MBEDTLS_SHA512_C=n
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA=n
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA_PSK=n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_RSA=y

#
# MQTT
#
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TRANSPORT_SSL=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET_SECURE=n

#
# Gateway defaults (override via menuconfig / sdkconfig)
#
CONFIG_ZBGW_PRIMARY_CHANNEL=15
CONFIG_ZBGW_PERMIT_JOIN_SECONDS=180
# CONFIG_ZBGW_ZIGBEE_ONLY_DIAG is not set
# CONFIG_ZBGW_PAIR_BEFORE_WIFI is not set
# CONFIG_ZBGW_DEV_PAIR_TEST is not set
CONFIG_ZBGW_LED_GPIO=15
CONFIG_ZBGW_BOOT_GPIO=9
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_ZBGW_OTA_URL="https://homesolar.percolate.one/fw/zigbee-gateway.bin"
CONFIG_ZBGW_DIAG_URL="https://homesolar.percolate.one/api/diag/zbgw"
# CONFIG_ZBGW_OTA_CHECK_ON_BOOT is not set
CONFIG_ZBGW_WIFI_SSID="YOUR_WIFI_SSID"
CONFIG_ZBGW_WIFI_PASSWORD="YOUR_WIFI_PASSWORD"
CONFIG_ZBGW_MQTT_HOST="192.168.50.41"
CONFIG_ZBGW_MQTT_PORT=1883
CONFIG_ZBGW_MQTT_TOPIC_PREFIX="zigbee-gw"
