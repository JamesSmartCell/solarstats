menu "Zigbee Gateway Configuration"

    config ZBGW_WIFI_SSID
        string "WiFi SSID (setup form default)"
        default "YOUR_WIFI_SSID"
        help
            Prefills the ZIGBEE_SETUP form only. Never auto-joins.
            If NVS has no stored network, the SoftAP portal always opens.

    config ZBGW_WIFI_PASSWORD
        string "WiFi password (setup form default)"
        default "YOUR_WIFI_PASSWORD"
        help
            Prefills the setup form only. Runtime password is stored in NVS.

    config ZBGW_MQTT_HOST
        string "MQTT broker hostname or IP (seed only)"
        default "192.168.50.41"
        help
            Seed for NVS / the setup form. Runtime host is stored in NVS.
            Empty or unreachable hosts trigger a sequential LAN scan of
            port 1883 on the STA /24. Prefer a LAN IP on ESP32-C6 — .local
            mDNS is unreliable with Zigbee Wi-Fi coexistence.

    config ZBGW_MQTT_PORT
        int "MQTT broker port"
        range 1 65535
        default 1883

    config ZBGW_MQTT_USERNAME
        string "MQTT username (seed only)"
        default "zigbee-gw"
        help
            Seed only. Runtime username is stored in NVS.

    config ZBGW_MQTT_PASSWORD
        string "MQTT password (seed only)"
        default "change-me"
        help
            Seed only. Runtime password is stored in NVS.

    config ZBGW_SETUP_AP_SSID
        string "First-boot setup SoftAP name"
        default "ZBGW-SETUP"
        help
            Open AP when NVS has no Wi-Fi credentials.

    config ZBGW_OTA_URL
        string "HTTPS OTA firmware URL"
        default "https://homesolar.percolate.one/fw/zigbee-gateway.bin"
        help
            Public HTTPS URL for zigbee-gateway.bin on solarstats
            (homesolar). Same image is used for every gateway; Wi-Fi
            and MQTT stay in NVS across updates.

    config ZBGW_DIAG_URL
        string "Anonymous diagnostics HTTPS URL"
        default "https://homesolar.percolate.one/api/diag/zbgw"
        help
            POST target for failures, boot, and hourly health. Only used
            when the setup checkbox "Allow anonymous diagnostics" is on
            (default). No Wi-Fi or MQTT passwords are sent.

    config ZBGW_DIAG_TOKEN
        string "Diagnostics product token"
        default "zbgw-anon-v1"
        help
            Sent as X-ZBGW-Diag. Must match solarstats ZBGW_DIAG_TOKEN.

    config ZBGW_OTA_CHECK_ON_BOOT
        bool "Auto-check OTA (~90s after Wi-Fi, then every 12h)"
        default y
        help
            Compare the hosted image version to this build using dotted
            numbers (1.2.10 > 1.2.9). Flash only if the remote version is
            higher. Same or older images are skipped. MQTT …/bridge/ota
            still forces a check.

    config ZBGW_MQTT_TOPIC_PREFIX
        string "MQTT topic prefix"
        default "zigbee-gw"
        help
            First path segment. The STA MAC is appended at runtime
            (zigbee-gw/<mac>/...) so several C6s can share one broker.

    config ZBGW_PRIMARY_CHANNEL
        int "Zigbee primary channel"
        range 11 26
        default 15
        help
            Prefer channels that do not overlap your 2.4 GHz Wi-Fi
            (avoid Zigbee 11-14 near Wi-Fi 1, 16-19 near Wi-Fi 6, 21-24 near Wi-Fi 11).
            Channel 15 or 25 is often a good starting point.

    config ZBGW_SECONDARY_CHANNEL_MASK
        hex "Zigbee secondary channel mask"
        default 0x07FFF800
        help
            Fallback channel mask if formation on the primary channel fails.

    config ZBGW_PERMIT_JOIN_SECONDS
        int "Permit-join window (seconds)"
        range 1 254
        default 30
        help
            Exclusive pairing window. Wi-Fi is down for this time, or until
            a device announces — whichever is first.

    config ZBGW_LED_GPIO
        int "Status LED GPIO"
        default 15
        help
            FireBeetle 2 ESP32-C6 onboard LED is GPIO15.

    config ZBGW_BOOT_GPIO
        int "BOOT / permit-join button GPIO"
        default 9
        help
            FireBeetle 2 ESP32-C6 BOOT button is GPIO9 (active low).

    config ZBGW_MAX_CHILDREN
        int "Max Zigbee children"
        range 1 32
        default 16

    config ZBGW_ZIGBEE_ONLY_DIAG
        bool "Zigbee-only join diagnostic (no WiFi/MQTT)"
        default n
        help
            Never start WiFi or MQTT. Form the Zigbee network, open permit-join,
            and wait for Device announce. Use to test whether the 802.15.4 radio
            can hear plugs at all.

    config ZBGW_PAIR_BEFORE_WIFI
        bool "Open permit-join before WiFi on boot"
        default n
        depends on !ZBGW_ZIGBEE_ONLY_DIAG
        help
            After Zigbee forms, open a pairing window with WiFi still down so
            the C6 RF is exclusive. Best for stubborn plugs. Disable once
            pairing is reliable.

    config ZBGW_PAIR_BEFORE_WIFI_SECONDS
        int "Pre-WiFi pairing window (seconds)"
        depends on ZBGW_PAIR_BEFORE_WIFI
        range 30 254
        default 180

    config ZBGW_SERIAL_LOG
        bool "USB serial logging (debug build)"
        default n
        help
            Off for a release image: ESP_LOG is compiled out / muted.
            Anonymous diagnostics HTTP still runs. Enable for USB
            monitor (idf.py -DZBGW_DEBUG=1 reconfigure).

    config ZBGW_DEV_PAIR_TEST
        bool "Run pair+toggle soak test before WiFi"
        default n
        help
            After Zigbee forms, pause and open permit-join, wait for an On/Off
            plug, then toggle it. Keep off for normal gateway use.

endmenu
