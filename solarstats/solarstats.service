[Unit]
Description=Solarstats — PowMr ingest API and /solarstats dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=james
Group=james
WorkingDirectory=/home/james/dev/solarstats/solarstats
# App loads .env from WorkingDirectory via dotenv
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
