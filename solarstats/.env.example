PORT=8787
INGEST_SECRET=change-me
DB_PATH=./data/solarstats.db

# Extra sites (comma-separated slugs). Each needs SITE_<SLUG>_SECRET.
# Dashboard: /rivermill   Ingest: POST /api/ingest/rivermill
SITES=rivermill
SITE_RIVERMILL_SECRET=change-me-rivermill
SITE_RIVERMILL_NAME=Rivermill
SITE_HOME_NAME=Home
HISTORY_RETENTION_DAYS=30

SESSION_SECRET=change-me-long-random
ORIGIN=https://homesolar.percolate.one
RP_ID=homesolar.percolate.one
COOKIE_SECURE=1

# Approved admin account (only this email sees /admin)
ADMIN_EMAIL=you@example.com

# Zigbee gateway anonymous diagnostics (must match firmware CONFIG_ZBGW_DIAG_TOKEN)
ZBGW_DIAG_TOKEN=zbgw-anon-v1
ZBGW_DIAG_DB_PATH=./data/zbgw_diag.db
# Optional. Default is ./data/fw/zigbee-gateway.bin
# ZBGW_FW_DIR=./data/fw

# Microsoft (optional if Google/Apple configured)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT=consumers
# Existing Azure redirect — keep as registered in Entra:
AUTH_REDIRECT_URI=https://homesolar.percolate.one/auth/callback

# Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://homesolar.percolate.one/auth/callback/google

# Apple Sign In (optional — Apple Developer → Identifiers → Services ID)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM contents with \n escapes, or path to .p8 file:
# APPLE_PRIVATE_KEY=
# APPLE_PRIVATE_KEY_PATH=/path/to/AuthKey_XXX.p8
APPLE_REDIRECT_URI=https://homesolar.percolate.one/auth/callback/apple
