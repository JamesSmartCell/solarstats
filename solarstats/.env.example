PORT=8787
INGEST_SECRET=change-me
DB_PATH=./data/solarstats.db
HISTORY_RETENTION_DAYS=30

# Microsoft Entra / identity platform (personal accounts → consumers)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT=consumers
AUTH_REDIRECT_URI=https://solar.example.com/auth/callback
SESSION_SECRET=change-me-long-random

# Public site origin + WebAuthn relying party (must match browser host)
ORIGIN=https://solar.example.com
RP_ID=solar.example.com

# Set to 1 behind HTTPS (Caddy). Leave unset for local http://127.0.0.1
COOKIE_SECURE=1
