#
# Partition Table
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

#
# Zigbee
#
CONFIG_ZB_ENABLED=y

#
# Wi-Fi / IEEE 802.15.4 coexistence (ESP32-C6)
#
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

#
# FreeRTOS
#
CONFIG_FREERTOS_HZ=1000

#
# mbedTLS — keep size down; LAN MQTT without TLS by default
#
CONFIG_MBEDTLS_AES_C=y
CONFIG_MBEDTLS_CCM_C=y
CONFIG_MBEDTLS_GCM_C=n
CONFIG_MBEDTLS_CMAC_C=n
CONFIG_MBEDTLS_SHA512_C=n
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA=n
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA_PSK=n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_RSA=n

#
# MQTT
#
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TRANSPORT_SSL=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET_SECURE=n

CONFIG_ZBGW_PRIMARY_CHANNEL=15
CONFIG_ZBGW_PERMIT_JOIN_SECONDS=180
CONFIG_ZBGW_LED_GPIO=15
CONFIG_ZBGW_BOOT_GPIO=9
CONFIG_ZBGW_MQTT_PORT=1883
CONFIG_ZBGW_MQTT_TOPIC_PREFIX="halite-c6"
CONFIG_HALITE_IPC_UART_NUM=0
CONFIG_HALITE_IPC_TX_GPIO=16
CONFIG_HALITE_IPC_RX_GPIO=17
CONFIG_HALITE_IPC_BAUD=921600
# Our app_main owns boot. Hosted slave is a component, not the whole image.
# CONFIG_ESP_HOSTED_COPROCESSOR_APP_MAIN is not set
# CONFIG_HALITE_ESP_HOSTED is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
